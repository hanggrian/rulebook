{
  "name": "rulebook",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "pnpm -r build",
    "prelint": "pnpm -r lint",
    "lint": "stylebook .",
    "predoc": "rm -rf build/typedoc/",
    "doc": "typedoc --entryPointStrategy packages --out build/typedoc/ packages/rulebook-eslint/ packages/rulebook-typescript-eslint/"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "dependencies": {
    "rulebook-eslint": "workspace:*",
    "rulebook-typescript-eslint": "workspace:*",
    "codecheck-js": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hanggrian/stylebook": "0.3.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "@types/sinon": "22.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.3.15",
    "eslint-plugin-sort-class-members": "1.22.1",
    "eslint-vitest-rule-tester": "3.2.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "sinon": "22.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-dom": "0.1.1"
  }
}
