<?xml version="1.0" encoding="UTF-8"?>
<ruleset
  xmlns="http://codenarc.org/ruleset/1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://codenarc.org/ruleset/1.0 http://codenarc.org/ruleset-schema.xsd"
  xsi:noNamespaceSchemaLocation="http://codenarc.org/ruleset-schema.xsd">

  <description>All Rulebook rules.</description>

  <rule class="com.hanggrian.rulebook.codenarc.rules.BlockTagPunctuationRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.TodoCommentStyleRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.TrailingCommaInCallRule"/>

  <!-- Clipping -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.BlockCommentClippingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.BracesClippingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.BracketsClippingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.TagsClippingRule"/>

  <!-- Declaration -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.LowercaseDRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.LowercaseFRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.LowercaseHexRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.LowercaseIRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoPublicConstructorInUtilityClassRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoParenthesesInLambdaRule"/>

  <!-- Expression -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.SimpleSizeComparisonRule"/>

  <!-- Formatting -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoEmptyFileRule"/>

  <!-- Naming -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.AbbreviationAsWordRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.GenericNameRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.IllegalVariableNameRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoMeaninglessWordRule"/>

  <!-- Ordering -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.BlockTagOrderRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.CommonFunctionPositionRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ImportOrderRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.InnerClassPositionRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.MemberOrderRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ModifierOrderRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.OverloadFunctionPositionRule"/>

  <!-- Scripting -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.CentralizedDependencyRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.LazyApiRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoLonelyConfigurationRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.RootProjectNameRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ScriptFileNameRule"/>

  <!-- Spacing -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.BlockTagIndentationRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.BracesSpacingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.CaseSeparatorRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.MemberSeparatorRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.BlankLineBeforeBlockTagsRule"/>

  <!-- Statement -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoLonelyCaseRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoLonelyIfRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoNestedIfElseRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoRedundantDefaultRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoRedundantElseRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoUselessContinueRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoUselessReturnRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ShorthandAssignmentRule"/>

  <!-- Testing -->

  <!-- Trimming -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.BracketsTrimmingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.CommentTrimmingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoDuplicateBlankLineInCommentRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.NoDuplicateSpaceRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ParenthesesTrimmingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.TagsTrimmingRule"/>

  <!-- Wrapping -->
  <rule class="com.hanggrian.rulebook.codenarc.rules.AssignmentWrappingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ChainCallWrappingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.LambdaWrappingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.OperatorWrappingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.ParameterWrappingRule"/>
  <rule class="com.hanggrian.rulebook.codenarc.rules.StatementWrappingRule"/>
</ruleset>
